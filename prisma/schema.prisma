generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RegulationDocumentStatus {
  UPLOADED
  EXTRACTED
  REVIEW_REQUIRED
  APPROVED
  ACTIVE
  SUPERSEDED
  ARCHIVED
  REFERENCE_ONLY
}

enum RegulationRuleStatus {
  DRAFT
  REVIEW_REQUIRED
  APPROVED
  ACTIVE
  REJECTED
  SUPERSEDED
}

enum RegulationRuleKind {
  BCR_LIMIT
  FAR_BASE
  FAR_ALLOWED
  FAR_MAX
  FAR_INCENTIVE
  FAR_FORMULA
  USE_RESTRICTION
  DISTRICT_PLAN
  OVERLAY
  TRANSITION
  EXCEPTION
  OTHER
}

enum RegulationValueType {
  PERCENT
  PERCENT_POINT
  MULTIPLIER
  FORMULA
  BOOLEAN
  TEXT
  JSON
}

enum RegulationCombineMode {
  OVERRIDE
  ADD
  MAX
  MIN
  EXCLUSIVE
  FIRST_MATCH
  MANUAL_REVIEW
}

enum RegulationDocumentRelationType {
  AMENDS
  SUPERSEDES
  REPEALS
  IMPLEMENTS
  REFERENCES
  CORRECTS
  CONSOLIDATES
  RELATED_TO
}

enum RegulationScopeType {
  COUNTRY
  SIDO
  SIGUNGU
  EUPMYEONDONG
  ADMIN_CODE
  PNU
  PNU_PREFIX
  ADDRESS
  PLAN_AREA
  BBOX
  POLYGON
  CUSTOM
}

model Project {
  id         String     @id @default(uuid())
  name       String
  siteName   String?
  address    String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  scenarios  Scenario[]
}

model Scenario {
  id         String          @id @default(uuid())
  projectId  String
  name       String
  mode       String?
  siteJson   Json
  inputJson  Json
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  result     ScenarioResult?
  reports    ReportFile[]
}

model ScenarioResult {
  id              String    @id @default(uuid())
  scenarioId      String    @unique
  summaryJson     Json
  cashflowJson    Json
  sensitivityJson Json?
  comparisonJson  Json?
  warningsJson    Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  scenario        Scenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
}

model ReportFile {
  id          String    @id @default(uuid())
  scenarioId  String
  fileUrl     String
  fileName    String
  createdAt   DateTime  @default(now())

  scenario    Scenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
}

model RegulationDocument {
  id                 String                   @id @default(uuid())
  documentGroupKey   String?
  revision           Int                      @default(1)
  title              String
  issuer             String?
  jurisdiction       String?
  documentType       String?
  publicationType    String?
  documentNumber     String?
  noticeNumber       String?
  planName           String?
  planType           String?
  changeType         String?
  decisionDate       DateTime?
  publishedAt        DateTime?
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  status             RegulationDocumentStatus @default(UPLOADED)
  sourceSystem       String?
  sourceFileName     String
  sourceMimeType     String?
  sourceStorageKey   String?
  sourceHash         String?
  sourceUrl          String?
  officialSourceUrl  String?
  officialVerifiedAt DateTime?
  legalBasisJson     Json?
  publicationMetaJson Json?
  extractionJson     Json?
  extractionVersion  String?
  extractedAt        DateTime?
  reviewedBy         String?
  reviewedAt         DateTime?
  approvedBy         String?
  approvedAt         DateTime?
  notes              String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  rules              RegulationRule[]
  assets             RegulationDocumentAsset[]
  spatialScopes      RegulationSpatialScope[]
  outgoingRelations  RegulationDocumentRelation[] @relation("RegDocRelationFrom")
  incomingRelations  RegulationDocumentRelation[] @relation("RegDocRelationTo")

  @@index([jurisdiction, status])
  @@index([documentGroupKey, revision])
  @@index([documentNumber])
  @@index([noticeNumber])
  @@index([planName])
  @@index([decisionDate])
  @@index([effectiveFrom, effectiveTo])
}

model RegulationDocumentAsset {
  id                 String              @id @default(uuid())
  documentId         String
  assetType          String?
  title              String?
  fileName           String
  mimeType           String?
  storageKey         String?
  sourceUrl          String?
  fileHash           String?
  pageCount          Int?
  sequence           Int                 @default(0)
  extractionJson     Json?
  metadataJson       Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  document           RegulationDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sourceRules        RegulationRule[]
  spatialScopes      RegulationSpatialScope[]

  @@index([documentId, sequence])
  @@index([fileHash])
}

model RegulationDocumentRelation {
  id                 String                         @id @default(uuid())
  fromDocumentId     String
  toDocumentId       String
  relationType       RegulationDocumentRelationType
  note               String?
  sourceSection      String?
  sourcePageStart    Int?
  sourcePageEnd      Int?
  createdAt          DateTime                       @default(now())

  fromDocument       RegulationDocument             @relation("RegDocRelationFrom", fields: [fromDocumentId], references: [id], onDelete: Cascade)
  toDocument         RegulationDocument             @relation("RegDocRelationTo", fields: [toDocumentId], references: [id], onDelete: Cascade)

  @@unique([fromDocumentId, toDocumentId, relationType])
  @@index([toDocumentId, relationType])
}

model RegulationSpatialScope {
  id                 String               @id @default(uuid())
  documentId         String
  sourceAssetId      String?
  scopeType          RegulationScopeType
  name               String?
  code               String?
  pnu                String?
  address            String?
  geometryJson       Json?
  bboxJson           Json?
  metadataJson       Json?
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  sourceSection      String?
  sourcePageStart    Int?
  sourcePageEnd      Int?
  sourceExcerpt      String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  document           RegulationDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sourceAsset        RegulationDocumentAsset? @relation(fields: [sourceAssetId], references: [id], onDelete: SetNull)
  ruleLinks          RegulationRuleScope[]

  @@index([documentId, scopeType])
  @@index([scopeType, code])
  @@index([pnu])
  @@index([effectiveFrom, effectiveTo])
}

model RegulationRule {
  id                 String                 @id @default(uuid())
  documentId         String
  sourceAssetId      String?
  ruleKey            String
  version            Int                    @default(1)
  name               String
  kind               RegulationRuleKind
  status             RegulationRuleStatus   @default(DRAFT)
  jurisdiction       String?
  scopeJson          Json
  conditionJson      Json?
  valueType          RegulationValueType
  valueJson          Json
  formula            String?
  combineMode        RegulationCombineMode  @default(MANUAL_REVIEW)
  priority           Int                    @default(100)
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  transitionJson     Json?
  sourceSection      String?
  sourcePageStart    Int?
  sourcePageEnd      Int?
  sourceExcerpt      String?
  confidence         Float?
  reviewedBy         String?
  reviewedAt         DateTime?
  approvedBy         String?
  approvedAt         DateTime?
  notes              String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  document           RegulationDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sourceAsset        RegulationDocumentAsset? @relation(fields: [sourceAssetId], references: [id], onDelete: SetNull)
  auditLogs          RegulationRuleAudit[]
  scopeLinks         RegulationRuleScope[]

  @@unique([documentId, ruleKey, version])
  @@index([jurisdiction, kind, status])
  @@index([ruleKey, status])
  @@index([effectiveFrom, effectiveTo])
}

model RegulationRuleScope {
  id                 String                 @id @default(uuid())
  ruleId             String
  scopeId            String
  required           Boolean                @default(true)
  exclusion          Boolean                @default(false)
  createdAt          DateTime               @default(now())

  rule               RegulationRule         @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  scope              RegulationSpatialScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@unique([ruleId, scopeId])
  @@index([scopeId, required, exclusion])
}

model RegulationRuleAudit {
  id          String          @id @default(uuid())
  ruleId      String
  action      String
  actor       String?
  beforeJson  Json?
  afterJson   Json?
  note        String?
  createdAt   DateTime        @default(now())

  rule        RegulationRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, createdAt])
}
